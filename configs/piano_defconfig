# Kernel configuration: CONFIG_XNU_<NAME> becomes XNU_<NAME> for the kernel build script.
# y and n are 1 and 0, a quoted string or a number is passed through, {tree} is the build tree.
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
# CONFIG_XNU_NATIVE_UFS is not set
# CONFIG_XNU_NATIVE_ADRENO is not set
CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_DT_PANIC_REGION=y
# CONFIG_XNU_NATIVE_RAM_BLOCK is not set
# Early screen console and RAM log (13T BootProgress): shows how far XNU gets.
CONFIG_XNU_BOOT_PROGRESS=y
CONFIG_XNU_EARLY_BOOT_PROGRESS=y
CONFIG_XNU_SHENG_PMGR=y
