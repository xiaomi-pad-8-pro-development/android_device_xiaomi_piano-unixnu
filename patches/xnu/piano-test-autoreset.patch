+/* piano unattended test images: restart PIANO_TEST_AUTORESET_S seconds after bsd_init. */
+#define PIANO_TEST_AUTORESET_S 150
+extern void IOSleep(unsigned int milliseconds);
+extern void boot_progress_stage(const char *);
+static void
+piano_test_autoreset(void *arg __unused, wait_result_t wr __unused)
+{
+	boot_progress_stage("autoreset armed");
+	IOSleep(PIANO_TEST_AUTORESET_S * 1000);
+	{
+		/* unattended tests: 40 s more per USB console step (scripts/PianoUsbConsole.c) */
+		extern volatile unsigned piano_diag_step;
+		IOSleep(piano_diag_step * 40000);
+	}
+	printf("piano: test image autoreset after %d s\n", PIANO_TEST_AUTORESET_S);
+	boot_progress_stage("autoreset: PSCI SYSTEM_RESET");
+	/*
+	 * PSCI SYSTEM_RESET over SMC, the conduit ArmDTPlatform's reset uses;
+	 * PEHaltRestart did not reset this board from a kernel thread.
+	 */
+	register uint64_t x0 __asm__("x0") = 0x84000009;
+	register uint64_t x1 __asm__("x1") = 0;
+	register uint64_t x2 __asm__("x2") = 0;
+	register uint64_t x3 __asm__("x3") = 0;
+	__asm__ volatile ("smc #0" : "+r"(x0) : "r"(x1), "r"(x2), "r"(x3) : "memory");
+	boot_progress_stage("autoreset: PSCI returned");
+}
+
+void piano_test_autoreset_start(void);
 void
+piano_test_autoreset_start(void)
+{
+	unsigned on = 0;
+	if (!PE_parse_boot_argn("piano-autoreset", &on, sizeof(on)) || !on) {
+		return;         /* the host reboots the board over the USB console */
+	}
+	thread_t thread;
+	if (kernel_thread_start(piano_test_autoreset, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
